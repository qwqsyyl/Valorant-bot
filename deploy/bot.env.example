# Copy to data/bot.env and fill with your own configuration; keep permission 600.
VALORANT_BOT_QQ=
VALORANT_BOT_HOST=127.0.0.1
VALORANT_GROUP_ID=
ONEBOT_ACCESS_TOKEN=
VALORANT_CONFIRMED_RESET_HOUR=8
# VALORANT_CARD_FONT=/absolute/path/to/chinese-font.ttc
# VALORANT_CARD_BACKGROUND=/absolute/path/to/background.png
# VALORANT_CARD_BACKGROUND_DIR=/absolute/path/to/backgrounds
# VALORANT_CARD_PANEL_ALPHA=96
# VALORANT_CARD_WEAPON_ALPHA=56
# Background modes: default (packaged fallback), fixed (one file), random (local pool).
# Leave MODE unset to keep the legacy directory > file > default behavior.
# Relative paths are based on the repository root. Full guide: REQUIREMENTS.md.
# VALORANT_CARD_BACKGROUND_MODE=default
# VALORANT_SHOP_BACKGROUND_MODE=random
# VALORANT_SHOP_BACKGROUND_DIR=data/backgrounds/shop
# VALORANT_SHOP_BACKGROUND=data/backgrounds/shop-fallback.jpg
# VALORANT_HISTORY_BACKGROUND_MODE=fixed
# VALORANT_HISTORY_BACKGROUND=data/backgrounds/history.jpg
# VALORANT_HISTORY_BACKGROUND_DIR=data/backgrounds/history
